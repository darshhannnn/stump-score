# MongoDB Configuration
# Atlas connection string (recommended) or local mongodb://localhost:27017/stumpscore
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stumpscore?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=change-me-to-a-long-random-string

# Server Configuration
NODE_ENV=development
PORT=5000

# Razorpay Keys (RAZORPAY_KEY_SECRET is server-side only, never expose in the client)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Cricket data sources (frontend keys)
# RapidAPI Cricbuzz (free: 100 req/month) - https://rapidapi.com/cricbuzz-cricbuzz/api/cricket-live-scores1/
REACT_APP_RAPIDAPI_KEY=
# CricAPI (free: 100 req/day) - https://cricapi.com/
REACT_APP_CRICAPI_KEY=

# Server-side CricAPI key (used by the /api/cricket proxy - keeps the key out of the client bundle)
CRICAPI_KEY=

# Razorpay webhook signature secret (optional - enables /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=

# Frontend -> backend base URL override (defaults to http://localhost:5000/api)
# REACT_APP_API_URL=

# Rate limits (requests per window)
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_AUTH=30
RATE_LIMIT_PASSWORD_RESET=10
RATE_LIMIT_COMMENTS=30
